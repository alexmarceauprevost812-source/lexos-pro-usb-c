[Desktop Entry]
Type=Application
Version=1.0
Name=LexOS Moteur
Comment=Interface IA portable — roule depuis la clé USB-C LEXOS
Exec=python3 -c "import sys,pathlib,urllib.parse,os; p=pathlib.Path(urllib.parse.unquote(urllib.parse.urlparse(sys.argv[1]).path)); os.execvp('bash',['bash',str(p.parent/'LANCER-MOTEUR.sh')])" %k
Icon=/media/marceau/LEXOS/MOTEUR-INTERFACE/interface/logo.png
Terminal=false
Categories=Development;Utility;
StartupNotify=true
